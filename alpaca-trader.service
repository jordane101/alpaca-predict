[Unit]
Description=Alpaca Trading Bot
After=network.target

[Service]
Type=simple
User=eli
WorkingDirectory=/home/eli/alpaca-predict
Environment="PATH=/home/eli/alpaca-predict/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/home/eli/alpaca-predict/.venv/bin/python /home/eli/alpaca-predict/scripts/trader_with_config.py
Restart=on-failure
RestartSec=10
StandardOutput=append:/home/eli/alpaca-predict/data/logs/trader_service.log
StandardError=append:/home/eli/alpaca-predict/data/logs/trader_service_error.log

# Optional: Set nice level for lower priority
# Nice=10

[Install]
WantedBy=multi-user.target
